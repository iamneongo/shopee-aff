{
  "manifest_version": 3,
  "name": "Shopee Aff Bridge",
  "version": "1.1.0",
  "description": "Cầu nối cho Shopee Aff API: nhận job từ server và tạo affiliate link ngay trong trang Shopee (chữ ký chống bot hợp lệ, không lỗi 90309999).",
  "permissions": ["tabs", "scripting", "alarms", "storage"],
  "host_permissions": [
    "https://affiliate.shopee.vn/*",
    "ws://localhost/*",
    "ws://127.0.0.1/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee Aff Bridge"
  }
}
